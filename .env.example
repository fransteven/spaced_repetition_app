# PostgreSQL connection string used by the app and Drizzle.
# Local example:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/srs"
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB_NAME"

# Auth.js / NextAuth secret used to sign sessions and JWTs.
# Required in production. Generate one with:
# openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-secret"

# Base URL of the application.
# Useful for local auth callbacks and required in many deployed environments.
AUTH_URL="http://localhost:3000"

# Legacy aliases supported by next-auth v5.
# Leave commented unless you specifically need compatibility with old tooling.
# NEXTAUTH_SECRET="replace-with-a-long-random-secret"
# NEXTAUTH_URL="http://localhost:3000"

# Gemini API key for the interactive LLM examiner (study session).
# Get one at https://aistudio.google.com/apikey
# Server-only — never expose to the client.
GEMINI_API_KEY="replace-with-your-gemini-api-key"
VOICE_WS_URL="ws://localhost:8000/v1/voice/ws"
VOICE_SERVICE_TOKEN="replace-with-a-long-random-shared-token"

# srs-llm-api (FastAPI + LangGraph + OpenAI): book Q&A, translation and card suggestions.
# LLM_SERVICE_TOKEN is shared with that service (>= 32 characters): openssl rand -hex 32
# The OpenAI key lives only in the srs-llm-api service, never here.
LLM_API_URL="http://localhost:8000"
LLM_SERVICE_TOKEN="replace-with-a-long-random-shared-token"
# Optional per-user daily caps on paid LLM calls (UTC day). Defaults: 100 / 300 / 100.
# LLM_DAILY_LIMIT_ASK=100
# LLM_DAILY_LIMIT_TRANSLATE=300
# LLM_DAILY_LIMIT_SUGGEST=100
# Free hosting (e.g. Render's free plan) stops srs-llm-api after 15 idle minutes and needs 30-60 s to start it again.
# Before each call to the service (and before issuing a voice ticket) the app waits up to this long for GET /health.
# Default 90000; set 0 for an always-on host.
# LLM_WAKE_TIMEOUT_MS=90000

# Google OAuth — sign-in only (scopes: openid email profile).
GOOGLE_CLIENT_ID="replace-with-your-google-client-id"
GOOGLE_CLIENT_SECRET="replace-with-your-google-client-secret"

# Cloudinary — card image uploads. Only the cloud name is public.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="replace-with-your-cloud-name"
CLOUDINARY_API_KEY="replace-with-your-cloudinary-api-key"
CLOUDINARY_API_SECRET="replace-with-your-cloudinary-api-secret"

# SMTP — reminder digest delivery via nodemailer.
# For Gmail use an app password (not the account password): smtp.gmail.com:465.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER="you@gmail.com"
SMTP_PASS="replace-with-your-app-password"
# Optional; falls back to SMTP_USER.
SMTP_FROM="NeuroCards <you@gmail.com>"

# Inngest — daily digest cron.
# Local dev: set INNGEST_DEV=1 and run `npm run inngest` alongside `npm run dev`.
INNGEST_DEV="1"
# Production only (from the Inngest dashboard); leave empty in local dev.
# INNGEST_EVENT_KEY=""
# INNGEST_SIGNING_KEY=""

# Vercel Blob — private storage for uploaded EPUBs and their covers.
# Create a Blob store in the Vercel dashboard and copy its read-write token.
BLOB_READ_WRITE_TOKEN=""
